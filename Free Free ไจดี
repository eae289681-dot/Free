-- โหลด UI Library (Orion Library)
local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()
local Window = OrionLib:MakeWindow({Name = "My Delta Script", HidePremium = false, SaveConfig = true, ConfigFolder = "DeltaTest"})

-- สร้าง Tab เมนูหลัก
local MainTab = Window:MakeTab({
    Name = "หลัก (Main)",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

-- สร้าง Slider ปรับความเร็วเดิน (WalkSpeed)
MainTab:AddSlider({
    Name = "ความเร็วการเดิน (WalkSpeed)",
    Min = 16,
    Max = 200,
    Default = 16,
    Color = Color3.fromRGB(255,255,255),
    Increment = 1,
    ValueName = "Speed",
    Callback = function(Value)
        game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = Value
    end    
})

-- สร้าง Toggle เปิด/ปิด การกระโดดสูง
MainTab:AddToggle({
    Name = "กระโดดสูง (High Jump)",
    Default = false,
    Callback = function(Value)
        if Value then
            game.Players.LocalPlayer.Character.Humanoid.JumpPower = 100
        else
            game.Players.LocalPlayer.Character.Humanoid.JumpPower = 50
        end
    end    
})

OrionLib:Init()
